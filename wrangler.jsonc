{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cent",
	"main": "worker/index.ts",
	"compatibility_date": "2025-01-01",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"kv_namespaces": [
		{
			"binding": "INBOX_KV",
			"id": "b77f892c99ab463380a118279a6b8bce"
		}
	],
	"vars": {
		"GITHUB_REPO": "Psychorayda/cent-journal-TEST",
		"OWNER_GITHUB_ID": "139367325",
		"FALLBACK_EXPENSE_CATEGORY": "other-expenses",
		"FALLBACK_INCOME_CATEGORY": "other-income",
		"CREDIT_CARD_REPAYMENT_POLICY": "expense"
	},
	"routes": [
		{
			"pattern": "cent.sunyuchen.party",
			"custom_domain": true
		}
	]
}
