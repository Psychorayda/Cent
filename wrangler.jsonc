{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cent",
	"compatibility_date": "2025-01-01",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{
			"pattern": "cent.sunyuchen.party",
			"custom_domain": true
		}
	]
}
